local cylinder_radius = 25
local cylinder_height = 50
local cylinder_wall_thickness = 2
local cylinder_wall_material = Enum.Material.WoodPlanks
local cylinder_wall_color = BrickColor.new("White")
local cylinder_spawn_on_humanoid = false
local cylinder_polygon_sides = 16

local thing = World:ToggleDropdown("Spawn Cylinder", nil, function(t)
	if t then
		local lp = game.Players.LocalPlayer
		local playerBuilding = workspace:WaitForChild("Buildings"):WaitForChild(lp.Name)
		local clientNode = playerBuilding:WaitForChild("Node"):WaitForChild("Node")
		local buildEvent = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("BuildingEvent")
		local baseCFrame

		if cylinder_spawn_on_humanoid then
			local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then
				warn("HumanoidRootPart not found! Defaulting to Building Node.")
				baseCFrame = clientNode:GetPivot()
			else
				baseCFrame = hrp.CFrame
			end
		else
			baseCFrame = clientNode:GetPivot()
		end

		local halfThickness = cylinder_wall_thickness / 2
		local halfHeight = cylinder_height / 2

		local function placeWall(position, size, rotation)
			local finalCFrame = baseCFrame * CFrame.new(position) * rotation
			buildEvent:FireServer(
				1,
				"Resizable Wall",
				finalCFrame,
				nil,
				cylinder_wall_color,
				nil, nil,
				cylinder_wall_material
			)

			local part = clientNode.Parent.Parent.ChildAdded:Wait()
			buildEvent:FireServer(7, part, part:GetPivot(), nil, size)
		end

		-- fl
		placeWall(
			Vector3.new(0, -halfHeight + halfThickness, 0),
			Vector3.new(cylinder_radius * 2, cylinder_wall_thickness, cylinder_radius * 2),
			CFrame.new()
		)

		-- ce
		placeWall(
			Vector3.new(0, halfHeight - halfThickness, 0),
			Vector3.new(cylinder_radius * 2, cylinder_wall_thickness, cylinder_radius * 2),
			CFrame.new()
		)
		
		local radius = cylinder_radius
		for i = 0, cylinder_polygon_sides - 1 do
			local angle = (2 * math.pi / cylinder_polygon_sides) * i
			local cosAngle = math.cos(angle)
			local sinAngle = math.sin(angle)

			local pos = Vector3.new(cosAngle * radius, 0, sinAngle * radius)
			local arcLength = (2 * math.pi * radius) / cylinder_polygon_sides
			local wallSize = Vector3.new(cylinder_wall_thickness, cylinder_height - 2 * cylinder_wall_thickness, arcLength)
			local rotation = CFrame.Angles(0, -angle, 0)

			placeWall(pos, wallSize, rotation)
		end
	end
end)

