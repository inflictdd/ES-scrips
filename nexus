local function CreateTracer(cf1, cf2, time, check)
    if not check then return end
    local TracersFolder = workspace:FindFirstChild("Particles")
    local TweenService = game:GetService("TweenService")
    local thickness = 0.1
    local midpt = (cf1 + cf2) / 2
    local dist = (cf1 - cf2).Magnitude

    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Transparency = 0.5
    part.Color = Color3.fromRGB(125, 125, 125)
    part.Size = Vector3.new(thickness, thickness, dist)
    part.CFrame = CFrame.lookAt(midpt, cf2)
    part.Name = "nxs_tracer"
    part.Parent = TracersFolder

    task.spawn(function()
        task.wait(time / 2)
        local tweenInfo = TweenInfo.new(time / 2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

        local tween = TweenService:Create(part, tweenInfo, { Transparency = 1 })

        tween:Play()
        tween.Completed:Wait()
        part:Destroy()
    end)
end

