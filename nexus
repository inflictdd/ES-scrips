Util:Button("Bring Vehicles", function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local InteractEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("InteractEvent")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")

	local player = Players.LocalPlayer
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")

	local CarTeleportSuccess = false

	local originalCFrame = rootPart.CFrame
	local originalPosition = originalCFrame.Position

	local function isSeatFreeAndStill(seat)
		return seat:IsA("VehicleSeat") and not seat.Occupant and seat.AssemblyLinearVelocity.Magnitude < 1
	end

	local function teleportCar(carModel)
		if not carModel then return false end

		for _, part in ipairs(carModel:GetDescendants()) do
			if part:IsA("BasePart") then
				pcall(function()
					part:SetNetworkOwner(player)
				end)

			end
		end

		RunService.Heartbeat:Wait()

		local root = carModel.PrimaryPart or carModel:FindFirstChildWhichIsA("BasePart")
		if root then
			local offset = originalPosition - root.Position
			carModel:TranslateBy(offset)
			return true
		end
		return false
	end

	local function processSeats()
		local successCount = 0
		local totalCount = 0

		for _, seat in ipairs(Workspace.Vehicles:GetDescendants()) do
			if isSeatFreeAndStill(seat) then
				totalCount += 1

				local carModel = seat:FindFirstAncestorOfClass("Model")
				if not carModel then continue end

				rootPart.Anchored = true
				rootPart.CFrame = seat.CFrame + Vector3.new(0, 5, 0) -- hov

				InteractEvent:FireServer(seat)
				task.wait(0.25)

				for _, part in ipairs(carModel:GetDescendants()) do
					if part:IsA("BasePart") then
						pcall(function()
							part:SetNetworkOwner(player)
						end)
						part.Anchored = false
					end
				end

				rootPart.CFrame = originalCFrame

				if teleportCar(carModel) then
					successCount += 1
					print("tped:", carModel.Name)
				else
				end
			end
		end

		rootPart.CFrame = originalCFrame
		rootPart.Anchored = false
		humanoid.Sit = false
		humanoid.Jump = true

		CarTeleportSuccess = (successCount == totalCount and totalCount > 0)
	end

	processSeats()
end)

