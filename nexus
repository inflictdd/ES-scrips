local function GetNodeSize(nodePart)
	local mesh = nodePart:FindFirstChildWhichIsA("SpecialMesh")
	if not mesh then
		return nodePart.Size
	end

	return Vector3.new(
		nodePart.Size.X * mesh.Scale.X,
		nodePart.Size.Y * mesh.Scale.Y,
		nodePart.Size.Z * mesh.Scale.Z
	)
end

local function ClampPositionToNode(worldPos, nodePart)
	local nodeCF = nodePart.CFrame
	local nodeSize = GetNodeSize(nodePart)
	local half = nodeSize / 2

	local localPos = nodeCF:PointToObjectSpace(worldPos)

	local clampedLocal = Vector3.new(
		math.clamp(localPos.X, -half.X, half.X),
		math.clamp(localPos.Y, -half.Y, half.Y),
		math.clamp(localPos.Z, -half.Z, half.Z)
	)

	return nodeCF:PointToWorldSpace(clampedLocal)
end

local function SpawnNeonCube(centerCFrame, cubeSize)
	local Building = workspace.Buildings:FindFirstChild(lp.Name)
	if not Building then return end

	local NodeFolder = Building:FindFirstChild("Node")
	if not NodeFolder then return end

	local ClientNode = NodeFolder:FindFirstChild("Node")
	if not ClientNode then return end

	local BuildEvent = sv.ReplicatedStorage.Events.BuildingEvent
	local parent = ClientNode.Parent.Parent

	local half = cubeSize / 2
	local wallThickness = 1
		local function SpawnWall(offsetCF, wallSize)
				local finalCF = centerCFrame * offsetCF
				local colors = {"Institutional white", "Pink", "Persimmon", "Deep blue"}
		        local color = BrickColor.new(colors[math.random(1, #colors)])
				BuildEvent:FireServer(
						1,
						"Resizable Wall",
						finalCF,
						nil,
						color,
						nil,
						nil,
						Enum.Material.Neon
				)
				local spawned = parent.ChildAdded:Wait()
				BuildEvent:FireServer(7, spawned, spawned:GetPivot(), nil, wallSize)
		end

	-- +X wall
	SpawnWall(
		CFrame.new( half.X, 0, 0),
		Vector3.new(wallThickness, cubeSize.Y, cubeSize.Z)
	)

	-- -X wall
	SpawnWall(
		CFrame.new(-half.X, 0, 0),
		Vector3.new(wallThickness, cubeSize.Y, cubeSize.Z)
	)

	-- +Y wall (top)
	SpawnWall(
		CFrame.new(0,  half.Y, 0),
		Vector3.new(cubeSize.X, wallThickness, cubeSize.Z)
	)

	-- -Y wall (bottom)
	SpawnWall(
		CFrame.new(0, -half.Y, 0),
		Vector3.new(cubeSize.X, wallThickness, cubeSize.Z)
	)

	-- +Z wall
	SpawnWall(
		CFrame.new(0, 0,  half.Z),
		Vector3.new(cubeSize.X, cubeSize.Y, wallThickness)
	)

	-- -Z wall
	SpawnWall(
		CFrame.new(0, 0, -half.Z),
		Vector3.new(cubeSize.X, cubeSize.Y, wallThickness)
	)

	--CreateNote("Nexus Client", "Neon cube spawned.", 1)
end

