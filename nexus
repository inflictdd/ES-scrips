local function draggable(obj, grid)
	grid = grid or 1
	obj.Active = true

	local dragging = false
	local startMouse
	local startPos
	local con

	local tweenInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	obj.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

		dragging = true
		startMouse = Vector2.new(input.Position.X, input.Position.Y)
		startPos = obj.Position

		if con then con:Disconnect() end

		con = run.RenderStepped:Connect(function()
			if not dragging then return end

			local delta = Vector2.new(mouse.X, mouse.Y) - startMouse
			local screen = workspace.CurrentCamera.ViewportSize
			local cellX = screen.X / grid
			local cellY = screen.Y / grid
			local newX = math.floor((startPos.X.Offset + delta.X) / cellX + 0.5) * cellX
			local newY = math.floor((startPos.Y.Offset + delta.Y) / cellY + 0.5) * cellY

			local goal = {
				Position = UDim2.new(
					startPos.X.Scale,
					newX,
					startPos.Y.Scale,
					newY
				)
			}

			TweenService:Create(obj, tweenInfo, goal):Play()
		end)
	end)

	obj.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

		dragging = false

		if con then
			con:Disconnect()
			con = nil
		end
	end)
end

local function disconnectconnections(t)
	if type(t) ~= "table" then return end

	for k, v in pairs(t) do
		if typeof(v) == "RBXScriptConnection" then
			v:Disconnect()
		elseif type(v) == "table" then
			disconnectconnections(v)
		end
		t[k] = nil
	end
end

local function RandomString(int)
	local charset = "QWERTYUIOPASDFGHJKLZXCVBNM1234567890abcdefghijklmnopqrstuvxyz"
	local fstr = ""
	for i = 1,int do
		local r = math.random(1,#charset)
		fstr = fstr..charset:sub(r,r)
	end
	return fstr
end

local function formatTime(totalSeconds, day)
    totalSeconds = math.floor(totalSeconds)

    if not day then
        local hours = math.floor(totalSeconds / 3600)
        local minutes = math.floor((totalSeconds % 3600) / 60)
        local seconds = totalSeconds % 60
        return string.format("%02d:%02d:%02d", hours, minutes, seconds)
    else
        local days = math.floor(totalSeconds / 86400)
        local hours = math.floor((totalSeconds % 86400) / 3600)
        local minutes = math.floor((totalSeconds % 3600) / 60)
        local seconds = totalSeconds % 60
        return string.format("%d:%02d:%02d:%02d", days, hours, minutes, seconds)
    end
end

local function formatCompactTime(totalSeconds)
	totalSeconds = math.floor(totalSeconds)
	local days = math.floor(totalSeconds / 86400)
	local hours = math.floor((totalSeconds % 86400) / 3600)
	local minutes = math.floor((totalSeconds % 3600) / 60)
	local seconds = totalSeconds % 60
	local result = ""

	if days > 0 then
		result ..= days .. "d "
	end
	if hours > 0 or days > 0 then
		result ..= hours .. "h "
	end
	if minutes > 0 or hours > 0 or days > 0 then
		result ..= minutes .. "m "
	end

	result ..= seconds .. "s"
	return result
end

