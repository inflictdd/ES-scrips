local vehicle_to_get

local thing = World:ToggleDropdown("Get Vehicle", nil, function(t)
	UnfreezeCamera()
	if not t then return end
	
	task.delay(2, function()
		UnfreezeCamera()
	end)

	local vehiclesFolder = workspace:FindFirstChild("Vehicles")
	local interactEvent = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("InteractEvent")
	local plr = game.Players.LocalPlayer
	local char = plr.Character or plr.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")

	if not vehiclesFolder then return CreateNote("Nexus Client", "Vehicles folder not found.", 4) end

	local vehicle
    for _, v in vehiclesFolder:GetChildren() do
        if v.Name:lower():find(vehicle_to_get:lower()) then
            vehicle = v
        end
    end

	if not vehicle then return CreateNote("Nexus Client", "Vehicle not found.", 4) end

	local seat = vehicle:FindFirstChild("VehicleSeat")
	if not seat then return CreateNote("Nexus Client", "VehicleSeat not found in vehicle.", 4) end

	if seat.Occupant then
		return CreateNote("Nexus Client", "Someone is already sitting in the vehicle.", 4)
	end
	if not vehicle.PrimaryPart then
		vehicle.PrimaryPart = seat
	end
		FreezeCamera()
	local prevPos = hrp.CFrame
	hrp.CFrame = seat.CFrame + Vector3.new(0, 3, 0)
	task.wait(.1)
	interactEvent:FireServer(seat)
	task.wait(.1)
	vehicle:SetPrimaryPartCFrame(prevPos)
	task.wait(.1)
	hrp.CFrame = prevPos
		UnfreezeCamera()
end)

thing:TextBox("Vehicle Name", "Vehicle", function(t)
	vehicle_to_get = t
end)

