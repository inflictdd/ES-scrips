			a[2] = c.Humanoid:LoadAnimation(game:GetService("ReplicatedStorage").Animations.WheelAnims.Sit)
			a[3] = c.Humanoid:LoadAnimation(game:GetService("ReplicatedStorage").Animations.Loot)						
		else
			return
		end
        
        local currentAnim
        local prevAnim

        while togs.SpinBot.Toggled and task.wait(.025) do
            if not c or not c:FindFirstChild("Humanoid") or not c:FindFirstChild("HumanoidRootPart") then continue end

            c:PivotTo(c:GetPivot() * CFrame.Angles(0, math.random(-math.pi, math.pi) * 100, 0))

