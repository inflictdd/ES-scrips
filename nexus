local thing = Util:ToggleDropdown("Car Grabber", togs.CarGrabber.Toggled, function(t)
	togs.CarGrabber.Toggled = t
	if not t and connections.CarGrabber then
		connections.CarGrabber:Disconnect()
		connections.CarGrabber = nil
		return
	end
	if t then
		connections.CarGrabber = task.spawn(function()
			local Players = game:GetService("Players")
			local RunService = game:GetService("RunService")
			local RS = game:GetService("ReplicatedStorage")
			local plr = Players.LocalPlayer
			local char = plr.Character
			if not char then return end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not humanoid or not hrp then return end
			while togs.CarGrabber.Toggled do
				for _, seat in ipairs(workspace.Vehicles:GetDescendants()) do
					if not togs.CarGrabber.Toggled then break end
					if not seat:IsA("VehicleSeat") then continue end
					if humanoid.SeatPart then continue end
					local prevCF = hrp.CFrame
					RS.Events.InteractEvent:FireServer(seat)
					local t0 = tick()
					repeat
						RunService.Heartbeat:Wait()
					until humanoid.SeatPart == seat or tick() - t0 > 0.8
					if humanoid.SeatPart ~= seat then
						hrp.CFrame = prevCF
						continue
					end
					FreezeCamera()
					humanoid.Sit = false
					seat:Sit(nil)
					RunService.Heartbeat:Wait()
					hrp.CFrame = prevCF
					task.delay(0.05, UnfreezeCamera)
				end
				task.wait(togs.CarGrabber.Delay or 0.1)
			end
		end)
	end
