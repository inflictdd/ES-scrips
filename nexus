            end

            currentAnim = newAnim

            pcall(function()
                    if rng ~= prevAnim then
                    c.Humanoid.AutoRotate = false
                    currentAnim:Play()
                end
            end)
            prevAnim = rng
        end
		currentAnim:Stop()
		for _, anim in pairs(a) do
