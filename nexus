                            rotationAngle += _G.RotationSpeed * _G.SignLoopDelay * rotationDirection

                            if rotationAngle >= _G.RotationAmount then
                                rotationAngle = _G.RotationAmount
                                rotationDirection = -1
                            elseif rotationAngle <= -_G.RotationAmount then
                                rotationAngle = -_G.RotationAmount
                                rotationDirection = 1
                            end

                            local headPosition = Head.Position
                            local targetPosition = headPosition + Vector3.new(0, _G.HeightOffset, 0)
                            local targetLookVector = HRP.CFrame.LookVector

                            if currentPosition == nil then
                                currentPosition = targetPosition
                                currentLookVector = targetLookVector
                            end

