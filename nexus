Combat:Toggle("Death Return", togs.DeathReturn, function(t)
	togs.DeathReturn = t

	local Players = game:GetService("Players")
	local player = Players.LocalPlayer

	local deathPosition = nil
	local shouldTeleport = false
	local debounce = false

	local function disconnectDeathReturn()
		for _, conn in ipairs(connections.DeathReturn) do
			if conn and conn.Disconnect then
				conn:Disconnect()
			end
		end
		table.clear(connections.DeathReturn)
	end

	local function setupchar_dr(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if not humanoid then return end

		local diedConn = humanoid.Died:Connect(function()
			if togs.DeathReturn and not debounce then
				debounce = true
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if hrp then
					deathPosition = hrp.CFrame
					shouldTeleport = true
				end
			end
		end)
		table.insert(connections.DeathReturn, diedConn)

		task.defer(function()
			if not shouldTeleport then return end

			local hrp
			repeat task.wait() until character:FindFirstChild("HumanoidRootPart")
			hrp = character:FindFirstChild("HumanoidRootPart")

			task.wait(0.25)

			if togs.DeathReturn and hrp and deathPosition then
				local offset = Vector3.new(0, 5 + math.random(), 0)
				local targetPosition = deathPosition.Position + offset
				local lookVector = deathPosition.LookVector
				hrp.CFrame = CFrame.new(targetPosition, targetPosition + lookVector)
			end

			deathPosition = nil
			shouldTeleport = false
			debounce = false
		end)
	end

	if t then
		local charAddedConn = player.CharacterAdded:Connect(setupchar_dr)
		table.insert(connections.DeathReturn, charAddedConn)

		if player.Character then
			setupchar_dr(player.Character)
		end
	else
		disconnectDeathReturn()
	end
end)

