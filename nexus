local function raycast(p1, p2, includechar)
	local rp = RaycastParams.new()
	local ignore = {
		workspace.Vehicles,
		workspace.Particles,
		lp.Character
	}

	--if not lp.Flagged.Value then
	for i,v in plrs.players(plrs) do
		if i == 1 or not v.Character or v.Character == includechar or v.Flagged.Value then continue end

		table.insert(ignore, v.Character)
	end
	--end

	rp.FilterDescendantsInstances = ignore
	rp.IgnoreWater = true
	rp.FilterType = Enum.RaycastFilterType.Exclude

	return workspace.Raycast(workspace, p1, p2 - p1, rp)
end

