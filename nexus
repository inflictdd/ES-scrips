Util:Toggle("Car Annoy", false, function(active)
	carAnnoyActive = active

	if not PlayerSelected or not plrs:FindFirstChild(PlayerSelected.Name) then
		CreateNote("Nexus Client", "Target player not found: " .. (PlayerSelected and PlayerSelected.Name or "nil"),4)
		return
	end

	local player = game.Players.LocalPlayer
	local target = PlayerSelected.Name
	local char = player.Character or player.CharacterAdded:Wait()
	local radius, f = 10, 0
	local increasing, increasing2 = true, true
	local fullcircle = 2 * math.pi
	local currentangle = CFrame.Angles(0,0,0)
	local currentrot = {0.1,-0.1,-0.1}
	local parts = carAnnoyParts

	if not active then
		if carAnnoyHeartbeat then
			carAnnoyHeartbeat:Disconnect()
			carAnnoyHeartbeat = nil
		end

		for _, loop in pairs(carAnnoyLoops) do
			if coroutine.status(loop) == "suspended" or coroutine.status(loop) == "running" then
				pcall(function() debug.sethook(loop) end)
			end
		end
		table.clear(carAnnoyLoops)

		for _, v in pairs(workspace.Vehicles:GetChildren()) do
			if v:FindFirstChild("Main") then
				if v.Main:FindFirstChild("BGYRO") then v.Main.BGYRO:Destroy() end
				if v.Main:FindFirstChild("BPOSITION") then v.Main.BPOSITION:Destroy() end
			end
		end
		table.clear(parts)
		return
	end

	local function createpositions(angle)
		return math.cos(angle) * radius, math.sin(angle) * radius
	end

	local function movecars()
		if not carAnnoyActive then return end

		currentangle *= CFrame.Angles(currentrot[1], currentrot[2], currentrot[3])

		radius = increasing and radius + 0.3 or radius - 0.3
		increasing = radius > 50 and false or (radius < 7 and true or increasing)

		f = increasing2 and f + 0.002 or f - 0.002
		increasing2 = f > 360 and false or (f < 1 and true or increasing2)

		for i, part in pairs(parts) do
			if part:FindFirstChild("VehicleSeat") and (part.VehicleSeat.Occupant == nil or part.VehicleSeat.Occupant == lp) and char:FindFirstChild("HumanoidRootPart") then
				local angle = i * (fullcircle / #parts) + f
				local x, y = createpositions(angle)
				local position = ((CFrame.new(char.HumanoidRootPart.Position) * currentangle) * CFrame.new(x, 0, y))
				part.Main.BPOSITION.Position = workspace[target].HumanoidRootPart.Position
				part.Main.BGYRO.CFrame = CFrame.Angles(
					math.rad(math.random(-180,180)),
					math.rad(math.random(-180,180)),
					math.rad(math.random(-180,180))
				)
			end
		end
	end

	carAnnoyHeartbeat = game:GetService("RunService").Heartbeat:Connect(function()
		if not carAnnoyActive then return end
		char = player.Character
		if not char then return end

		movecars()

		for _, v in pairs(workspace.Vehicles:GetChildren()) do
			coroutine.wrap(function()
				if v:FindFirstChild("VehicleSeat") and not v.Main:FindFirstChild("BGYRO") then
					local bg = Instance.new("BodyGyro", v.Main)
					local bp = Instance.new("BodyPosition", v.Main)
					bg.Name, bp.Name = "BGYRO", "BPOSITION"
					bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
					bg.P = 10000
					bg.D = 100
					bp.MaxForce = Vector3.new(9e9, 9e9, 9e9)
					bp.P = 10000
					bp.D = 100
					bp.Position = char.HumanoidRootPart.Position
					table.insert(parts, v)
				end
			end)()
		end

		pcall(function() char.Humanoid.Sit = false end)
	end)

	local shootLoop = coroutine.create(function()
		return nil
	end)

	local farmLoop = coroutine.create(function()
		while carAnnoyActive do
			task.wait(20)

			for _ = 1, 2 do
				coroutine.wrap(function()
					for i, v in pairs(parts) do
						if not (v and v:FindFirstChild("Main")) then
							parts[i] = nil
							continue
						end
						--find vehicle seat
						local seat
						for _, d in ipairs(v:GetDescendants()) do
							if d:IsA("VehicleSeat") then
								seat = d
								break
							end
						end
						if not seat then
							parts[i] = nil
							continue
						end
						--check
						if seatBusy then continue end
						seatBusy = true

						local char = player.Character
						local hum = char and char:FindFirstChild("Humanoid")
						local hrp = char and char:FindFirstChild("HumanoidRootPart")
						if not (hum and hrp) then
							seatBusy = false
							continue
						end

						if not returnCFrame then
							returnCFrame = hrp.CFrame
						end
                        if not prevTool then
                            prevTool = lchar:FindFirstChildWhichIsA("Tool") or nil
                        end
						task.delay(3,function() UnfreezeCamera() end)
						FreezeCamera()
						--sit (remote does the seating)
						hrp.Anchored = true
						game:GetService("ReplicatedStorage").Events.InteractEvent:FireServer(seat)
						hrp.Anchored = false

						--very fast wait for seat
						local t = tick()
						repeat task.wait()
						until hum.SeatPart ~= nil or tick() - t > 1.2

						pcall(function()
							seat.CanCollide = false
							seat.CanQuery = false
							seat.Throttle = 1
							seat.ThrottleFloat = 1

							for _, x in ipairs(v:GetDescendants()) do
								if x:IsA("BasePart") then
									x.CanCollide = false
									x.CanQuery = false
								end
							end
						end)

						hum.Sit = false
						hum.Jump = true

						t = tick()
						repeat task.wait()
						until hum.SeatPart == nil or tick() - t > 0.6

						hrp.Anchored = true
						hrp.CFrame = returnCFrame
						hrp.AssemblyLinearVelocity = Vector3.zero
						UnfreezeCamera()
						task.wait()
						hrp.Anchored = false
						task.wait()
						hrp.CFrame = returnCFrame
						returnCFrame = nil
                        if prevTool then
                            prevTool.Parent = lchar
                        end
						seatBusy = false
					end
				end)()

				task.wait(5)
			end
		end
	end)

	table.insert(carAnnoyLoops, farmLoop)
	coroutine.resume(farmLoop)

	local returnLoop = coroutine.create(function()
		while carAnnoyActive do
			task.wait()
			local pos = player.Character.HumanoidRootPart.Position
			local base = Vector3.new(-290.945709, 149.44014, -155.528885)
			if (pos - base).Magnitude > 20000 then
