        CreateNote("Nexus Client","Place a sign down if there isnt one.",2)

        _G.SignLoopDelay = 0.05

        _G.HeightOffset = 3
        _G.SignText = lp.Name
        _G.FollowSmoothness = 0.8

        _G.RGBDelay = 3
        _G.RotationSpeed = 50
        _G.RotationAmount = 15

        local Players = game:GetService("Players")
        local RS = game:GetService("ReplicatedStorage")
        local LocalPlayer = Players.LocalPlayer
        local BuildingEvent = RS:WaitForChild("Events"):WaitForChild("BuildingEvent")
        local MenuActionEvent = RS:WaitForChild("Events"):WaitForChild("MenuActionEvent")

        local sign = nil
        local signCreated = false

        local function getOrCreateSign()
            local buildingFolder = workspace:WaitForChild("Buildings"):WaitForChild(LocalPlayer.Name)
            sign = buildingFolder:FindFirstChild("Billboard Sign 1")
            if not sign then
                BuildingEvent:FireServer(1, "Billboard Sign 1", CFrame.new(0, 0, 0))
                repeat task.wait() until buildingFolder:FindFirstChild("Billboard Sign 1")
                sign = buildingFolder:FindFirstChild("Billboard Sign 1")
                signCreated = true
            end
            return sign
        end

        local rgbColors = {
            Color3.fromRGB(255, 0, 0),
            Color3.fromRGB(255, 127, 0),
            Color3.fromRGB(255, 255, 0),
            Color3.fromRGB(0, 255, 0),
            Color3.fromRGB(0, 0, 255),
            Color3.fromRGB(75, 0, 130),
            Color3.fromRGB(148, 0, 211)
        }

        local currentColorIndex = 1
        local lastColorUpdateTime = tick()
        local rotationAngle = 0  
        local rotationDirection = 1 
        local currentPosition = nil  
        local currentLookVector = nil 

        task.spawn(function()
            while _G.SignToggle do
                if _G.SignToggle then
                    local buildingFolder = workspace:FindFirstChild("Buildings")
                    if buildingFolder then
                        buildingFolder = buildingFolder:FindFirstChild(LocalPlayer.Name)
                    end
                    if buildingFolder then
                        local sign = buildingFolder:FindFirstChild("Billboard Sign 1")
                        if sign then
                            local currentTime = tick()
                            if currentTime - lastColorUpdateTime >= _G.RGBDelay then
                                lastColorUpdateTime = currentTime
                                currentColorIndex = currentColorIndex + 1
                                if currentColorIndex > #rgbColors then
                                    currentColorIndex = 1
                                end
                            end
                            
                            local currentColor = rgbColors[currentColorIndex]
                            pcall(function()
                                MenuActionEvent:FireServer(7, sign, {
                                    [1] = _G.SignText,
                                    [2] = currentColor
                                })
                            end)
                        end
                    end
                end
                task.wait(_G.RGBDelay)
            end
