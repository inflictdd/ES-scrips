	local outerOffset = (outerCubeSize - cubeSize) / 3
	local BuildingEvent = sv.ReplicatedStorage.Events.BuildingEvent

	local function getWallPositions(center, size, thickness, offset)
		return {
			{center + Vector3.new(0, 0, (size/2) + offset), CFrame.new(center + Vector3.new(0, 0, (size/2) + offset)), Vector3.new(size, size, thickness)},
			{center + Vector3.new(0, 0, -(size/2) - offset), CFrame.new(center + Vector3.new(0, 0, -(size/2) - offset)), Vector3.new(size, size, thickness)},
			{center + Vector3.new((size/2) + offset, 0, 0), CFrame.new(center + Vector3.new((size/2) + offset, 0, 0)) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(size, size, thickness)},
			{center + Vector3.new(-(size/2) - offset, 0, 0), CFrame.new(center + Vector3.new(-(size/2) - offset, 0, 0)) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(size, size, thickness)},
			{center + Vector3.new(0, (size/2) + offset, 0), CFrame.new(center + Vector3.new(0, (size/2) + offset, 0)) * CFrame.Angles(math.rad(90), 0, 0), Vector3.new(size, size, thickness)},
			{center + Vector3.new(0, -(size/2) - offset, 0), CFrame.new(center + Vector3.new(0, -(size/2) - offset, 0)) * CFrame.Angles(math.rad(-90), 0, 0), Vector3.new(size, size, thickness)}
		}
	end

	local function BuildCube()
		if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
		
		local center = targetPlayer.Character.HumanoidRootPart.Position
		local cubeWalls = getWallPositions(center, cubeSize, wallThickness, 0)
		local outerWalls = getWallPositions(center, outerCubeSize, outerWallThickness, outerOffset)
		
		local availableWalls = {}
		local folder = workspace.Buildings:FindFirstChild(lp.Name)
		if not folder then return end
		for _, Prop in ipairs(folder:GetChildren()) do
			if Prop.Name == "Resizable Wall" and Prop.PrimaryPart then
				table.insert(availableWalls, Prop)
			end
		end

		if #availableWalls < 12 then
			if connections["CubifyCharacter"] then connections["CubifyCharacter"]:Disconnect() connections["CubifyCharacter"] = nil end
			if connections["CubifyAdded"] then connections["CubifyAdded"]:Disconnect() connections["CubifyAdded"] = nil end
			if connections["CubifyRemoving"] then connections["CubifyRemoving"]:Disconnect() connections["CubifyRemoving"] = nil end
			CreateNote("Nexus Client", "Not enough resizeable walls available, stopping cubify.", 4)
			return
		end

		for i = 1, 12 do
			local Prop = availableWalls[i]
			local isOuterLayer = i > 6
			local wallSet = isOuterLayer and outerWalls or cubeWalls
			local index = ((i - 1) % 6) + 1
			local _, cframe, size = wallSet[index][1], wallSet[index][2], wallSet[index][3]

			BuildingEvent:FireServer(7, Prop, cframe, nil, size)
						Prop:SetAttribute('cubifywall',true)
		end
	end

	--build once
	BuildCube()

	--handle respawn
	connections["CubifyCharacter"] = targetPlayer.CharacterAdded:Connect(function(char)
		char:WaitForChild("HumanoidRootPart")
		BuildCube()
		CreateNote("Nexus Client", "Updated cube for respawned target.")
	end)

	--handle rejoin
	connections["CubifyRemoving"] = targetPlayer.AncestryChanged:Connect(function(_, parent)
		if not parent then
			--wait for rejoin
			connections["CubifyAdded"] = plrs.PlayerAdded:Connect(function(plr)
				if plr.Name == PlayerSelected.Name then
					targetPlayer = plr
					connections["CubifyCharacter"] = plr.CharacterAdded:Connect(function(char)
						char:WaitForChild("HumanoidRootPart")
						BuildCube()
						CreateNote("Nexus Client", "Updated cube for rejoined target.")
					end)
					BuildCube()
				end
			end)
		end
	end)

	CreateNote("Nexus Client", "Cubified " .. PlayerSelected.Name)
end)
]]

