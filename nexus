World:Button("Building Buddy", function()
	if not PlayerSelected then return CreateNote("Nexus Client", "Target player not found.",4) end
	if not workspace.Buildings:FindFirstChild(PlayerSelected.Name).Node.Node then return CreateNote("Nexus Client", "Target player's node not found.") end
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Workspace = game:GetService("Workspace")

	local LocalPlayer = Players.LocalPlayer
	local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local HRP = Character:WaitForChild("HumanoidRootPart")

	local BuildingEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("BuildingEvent")

	local VO = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("VO"))

	local finalPos = workspace.Buildings:FindFirstChild(PlayerSelected.Name).Node.Node.Position

	local angle = math.rad(90)
	local lookVec = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit

	local saveX = finalPos.X / (1 + lookVec.X)
	local saveZ = finalPos.Z - lookVec.Z * saveX
	local saveY = finalPos.Y

	local saveCFrame = CFrame.new(saveX, saveY, saveZ) * CFrame.Angles(0, angle, 0)


	local function wouldOverlap(saveCFrame)
	for _, model in ipairs(Workspace.Buildings:GetDescendants()) do
		if model:IsA("Model") and model.Name == "Node" then
			local part = model:FindFirstChild("Node")
			if part and part:IsA("BasePart") and part:FindFirstChildOfClass("BlockMesh") then
			local mesh = part:FindFirstChildOfClass("BlockMesh")
			if mesh.Scale == Vector3.new(60, 60, 60) then
			for x = -6, 6, 2 do
			for y = -6, 6, 2 do
			for z = -6, 6, 2 do
			local offset = Vector3.new(
			mesh.Scale.X * (x / 6),
			mesh.Scale.Y * (y / 6),
			mesh.Scale.Z * (z / 6)
			)
			local pointToCheck = (saveCFrame * CFrame.new(offset)).Position
			if VO.checknode(part, pointToCheck) then
				return true
			end
		end
	end
	end
	end
	end
	end
	end
	return false
	end

	if not wouldOverlap(saveCFrame) then
		BuildingEvent:FireServer(4, togs.CorruptNodeSlot, saveCFrame)
		CreateNote("Nexus Client", "Attempted to spawn corrupt node on target player's node.")
	else
		CreateNote("Nexus Client", "Can't spawn corrupted node due to overlapping.", 4)
	end
end)

