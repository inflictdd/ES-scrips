                            currentPosition = currentPosition:Lerp(targetPosition, lerpAlpha)
                            currentLookVector = currentLookVector:Lerp(targetLookVector, lerpAlpha)

                            local baseCF = CFrame.lookAt(currentPosition, currentPosition + currentLookVector)
                            local signCF = baseCF * CFrame.Angles(0, 0, math.rad(rotationAngle))

                            pcall(function()
                                BuildingEvent:FireServer(5, sign, signCF)
                            end)
                        end
                    end
