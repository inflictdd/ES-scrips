local function countItemsString(str) --count no. of items in item, item, item,
	local count = 0
	for _, item in ipairs(string.split(str, ",")) do
		local trimmed = item:match("^%s*(.-)%s*$")
		if trimmed ~= "" then
			count += 1
		end
	end
	return count
end

