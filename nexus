				player.Character.HumanoidRootPart.Velocity = Vector3.zero
			end
		end
	end)
	table.insert(carAnnoyLoops, returnLoop)
	coroutine.resume(returnLoop)

	local randLoop = coroutine.create(function()
		while carAnnoyActive do
			task.wait(5)
			currentrot = {
				math.random(-1,1)/10,
				math.random(-1,1)/10,
				math.random(-1,1)/10
			}
		end
	end)
	table.insert(carAnnoyLoops, randLoop)
	coroutine.resume(randLoop)
end)

